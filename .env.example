# =============================================================================
#  Frontend environment
# =============================================================================
#  Copy to `.env.local` and adjust if your backend runs elsewhere.
#
#      cp .env.example .env.local
#
#  NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
#  Never put a secret here — put it in backend/.env instead.
# =============================================================================

# Base URL of the Express API. Socket.IO connects to the same origin.
NEXT_PUBLIC_API_URL=https://appointment-backend-gz0d.onrender.com
